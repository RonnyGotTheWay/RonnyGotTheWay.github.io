APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://art_rank:art_rank_local@127.0.0.1:5432/art_rank
DATA_ROOT=./data
ARTIFACT_ROOT=./artifacts
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MODEL_STAGE=champion
LOG_LEVEL=INFO
ALERT_CHANNEL=none

# Licensed market-data adapter. Obtain rt_k permission from Tushare before use.
MARKET_DATA_PROVIDER=eastmoney
TUSHARE_TOKEN=
TUSHARE_API_URL=https://api.tushare.pro
# Official rt_k full-market pattern: ChiNext/SZ, SSE, main-board SZ and BSE.
REALTIME_SYMBOLS=3*.SZ,6*.SH,0*.SZ,9*.BJ
REALTIME_CACHE_SECONDS=600
REALTIME_REQUEST_TIMEOUT_SECONDS=8
CANDIDATE_MIN_AMOUNT_CNY=50000000

# Set true only after documenting permission for personal research use.
EASTMONEY_PERMISSION_CONFIRMED=false
EASTMONEY_ENDPOINT=https://push2.eastmoney.com/webguest/api/qt/clist/get
EASTMONEY_PAGE_SIZE=100
EASTMONEY_REQUEST_DELAY_SECONDS=0.25
EASTMONEY_REQUEST_TIMEOUT_SECONDS=20
BAOSTOCK_ENABLED=false
MODEL_HISTORY_YEARS=2
MODEL_MIN_DAILY_DAYS=480
MODEL_MIN_INTRADAY_COVERAGE=0.95
MODEL_MAX_MEMORY_GB=12
MODEL_RUN_STALE_MINUTES=30
TRAINING_HEARTBEAT_SECONDS=15
TRAINING_UNRESPONSIVE_SECONDS=90
LONG_TERM_INTRADAY_PROVIDER=eastmoney
SHORT_TERM_HISTORY_PROVIDER=eastmoney
HISTORY_PROVIDER_FALLBACKS=akshare_sina
FRONTEND_API_TIMEOUT_MS=10000
# Next.js only exposes browser variables with NEXT_PUBLIC_. Keep this equal to FRONTEND_API_TIMEOUT_MS.
NEXT_PUBLIC_FRONTEND_API_TIMEOUT_MS=10000
SHORT_TERM_SECONDARY_WORKERS=2
SHORT_TERM_SECONDARY_DELAY_SECONDS=0.5
SHORT_TERM_FAILURE_CIRCUIT=20
SHORT_TERM_HISTORY_WORKERS=4
SHORT_TERM_DAILY_COVERAGE=0.95
SHORT_TERM_INTRADAY_COVERAGE=0.85
